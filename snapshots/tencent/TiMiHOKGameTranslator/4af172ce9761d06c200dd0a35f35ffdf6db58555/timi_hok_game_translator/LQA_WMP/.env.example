# docker compose 部署配置: cp .env.example .env 后修改

# 以下密码/密钥必须修改为随机值
# 生成方式: python -c "import secrets;print(secrets.token_urlsafe(32))"
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-lqa
REDIS_PASSWORD=change-me-redis
SECRET_KEY=change-me-to-a-long-random-string

# 首次启动自动创建的超级管理员 (已存在超管时不会覆盖)
LQA_ADMIN_USERNAME=admin
LQA_ADMIN_PASSWORD=ChangeMe123456

# 对外端口与访问地址 (缺陷中的截图链接、Webhook 变量 {{lqa_server}} 使用)
LQA_HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080

# 是否开放自助注册 (注册后需管理员分配项目)
ALLOW_REGISTER=true
# HTTPS 部署时开启
SESSION_COOKIE_SECURE=false
# 截图是否允许匿名访问 (使用禅道且需要在禅道中直接显示截图时开启)
MEDIA_PUBLIC=false

# ---------------------------------------------------------------
# AI 识别服务
# ---------------------------------------------------------------

# 留空则自动使用随本编排启动的 ai 服务 (http://ai:8086)
# 若已有独立部署的识别服务, 填写其地址即可, 此时可用
# docker compose up -d --scale ai=0 跳过本地 ai 容器
AI_BASE_URL=

# 镜像内置的 OCR 引擎 (构建期生效)
#   rapidocr   默认, 离线可用, 约 15MB
#   paddleocr  精度更高, 镜像约 +2GB
#   easyocr    多语种
#   none       不内置, 需配合下方 OCR_* 指向外部/云 OCR
OCR_ENGINE=rapidocr

# 运行期使用的 OCR provider, 取值见 lqa_service/README.md
# OCR 是可选项: 留空或设为 none 时服务仍可正常启动与检测,
# 仅自动跳过依赖 OCR 的检测项 (错译、文本超文本框)
OCR_PROVIDER=rapidocr
OCR_LANG=ch

# ai 服务进程数; 识别为 CPU 密集型, 按核数调整
AI_WORKERS=2

# ai 服务对宿主机暴露的地址, 默认只监听本机便于调试
# 完全不对外暴露可改为 127.0.0.1:0, 或删除 compose 中 ai 的 ports
AI_HTTP_PORT=127.0.0.1:8086

# 使用云 OCR 时按需填写 (OCR_PROVIDER=tencentcloud/baidu/azure 等)
OCR_URL=
OCR_HOST=
OCR_API_KEY=
OCR_SECRET_ID=
OCR_SECRET_KEY=
OCR_REGION=ap-guangzhou

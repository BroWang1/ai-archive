# 复制为 server/.env 后按需修改 (也可以直接使用系统环境变量, 优先级更高)
DEBUG=true
APP_NAME=LQA
# 生产环境必须设置为随机字符串: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALLOWED_HOSTS=*

# 数据目录 (日志、临时文件) 与上传文件目录
APP_DATA_ROOT=./data/n0
APP_MEDIA_ROOT=./data/media_root

# MySQL 8 / Redis
MYSQL_URL=mysql://lqa:lqa_password@127.0.0.1:3306/lqa
REDIS_URL=rediscache://:redis_password@127.0.0.1:6379/1
CELERY_BROKER_URL=redis://:redis_password@127.0.0.1:6379/2
CELERY_BACKEND_URL=redis://:redis_password@127.0.0.1:6379/2

# 账号
ALLOW_REGISTER=true
# HTTPS 部署时开启
SESSION_COOKIE_SECURE=false

# 平台对外访问地址 (缺陷中的截图链接、Webhook 变量 {{lqa_server}} 使用), 如 https://lqa.example.com
PUBLIC_URL=
# 截图 (/media/) 是否允许匿名访问; 使用禅道并希望在禅道中直接显示截图时开启
MEDIA_PUBLIC=false

# AI 识别服务地址 (lqa_service 默认监听 8086)
AI_BASE_URL=http://127.0.0.1:8086

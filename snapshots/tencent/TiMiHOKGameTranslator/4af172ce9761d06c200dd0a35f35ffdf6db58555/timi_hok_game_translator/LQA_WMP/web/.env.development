# 开发环境自定义的环境变量（命名必须以 VITE_ 开头）

## 后端接口公共路径（开发环境通过 Vite 代理转发，见 vite.config.ts）
VITE_BASE_API = '/api-pro'

## 截图等资源地址前缀（与 BASE_API 相同，走同一个 vite 代理）
VITE_RESOURCE_API = '/api-pro'

## 开发代理目标：后端地址。可在 .env.development.local 中覆盖
VITE_PROXY_TARGET = 'http://127.0.0.1:8000/'

## 路由模式 hash 或 html5
VITE_ROUTER_HISTORY = 'html5'

## 开发环境地址前缀（一般 '/'，'./' 都可以）
VITE_PUBLIC_PATH = '/'

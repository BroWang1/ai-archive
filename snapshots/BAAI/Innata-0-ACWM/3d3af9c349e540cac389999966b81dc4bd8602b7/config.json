{
  "architectures": [
    "Cosmos3OmniModel"
  ],
  "auto_map": {
    "AutoConfig": "cosmos3.model.Cosmos3OmniConfig",
    "AutoModel": "cosmos3.model.Cosmos3OmniModel"
  },
  "dtype": "bfloat16",
  "model": {
    "_recursive_": false,
    "_target": "omni_mot_model",
    "config": {
      "_type": "omni_mot_model_config",
      "action_gen": true,
      "activation_checkpointing": {
        "determinism_check": "default",
        "mode": "selective",
        "preserve_rng_state": true,
        "save_ops_regex": [
          "fmha"
        ]
      },
      "attention_io_layout": "sequence_sharded",
      "causal_training_strategy": "none",
      "compile": {
        "ar_post_saturation_mode": "default",
        "compile_dynamic": true,
        "compiled_region": "language",
        "coordinate_descent_tuning": false,
        "enabled": false,
        "max_autotune_pointwise": false,
        "mix_order_reduction_split_size": 32,
        "use_cuda_graphs": false
      },
      "diffusion_expert_config": {
        "base_fps": 24,
        "enable_fps_modulation": true,
        "enable_media_modality_embedding": false,
        "enable_vision_modality_embeddings": false,
        "load_weights_from_pretrained": false,
        "max_vae_latent_side_after_patchify": 20,
        "patch_spatial": 2,
        "sound_base_temporal_compression_factor": null,
        "timestep_range": 1.0,
        "unified_3d_mrope_reset_spatial_ids": true,
        "unified_3d_mrope_temporal_modality_margin": 15000,
        "vision_temporal_position_mode": "latent_index",
        "vision_spatial_position_mode": "canvas"
      },
      "ema": {
        "enabled": false,
        "iteration_shift": 0,
        "rate": 0.1
      },
      "enable_input_bias": true,
      "exclude_reasoner_weights_from_checkpoint": false,
      "fixed_sequence_length": {
        "enabled": false,
        "gen_tokens": 0,
        "und_tokens": 0,
        "understanding_tokens": 0,
        "action_tokens": 0
      },
      "fixed_step_sampler_config": null,
      "flex_attention": {
        "backend": "auto",
        "enabled": false,
        "mask": {
          "noisy_attention_scope": "all_views"
        }
      },
      "gen_loss_scale": 1.0,
      "input_caption_key": "ai_caption",
      "input_image_key": "images",
      "input_video_key": "video",
      "input_video_latent_key": "video_latent",
      "joint_attn_implementation": "two_way",
      "latent_downsample_factor": 16,
      "lbl": {
        "coeff_gen": null,
        "coeff_und": null,
        "method": "local"
      },
      "load_vision_tokenizer": true,
      "load_vlm_visual": true,
      "log_enc_time_every_n": 100,
      "lora_alpha": 32,
      "lora_enabled": false,
      "lora_rank": 16,
      "lora_target_modules": "q_proj_moe_gen,k_proj_moe_gen,v_proj_moe_gen,o_proj_moe_gen",
      "max_action_dim": 64,
      "max_num_tokens_after_packing": 74000,
      "natten_parameter_list": null,
      "net": null,
      "num_embodiment_domains": 32,
      "parallelism": {
        "cfg_parallel_shard_degree": 1,
        "context_parallel_shard_degree": 1,
        "data_parallel_replicate_degree": 3,
        "data_parallel_shard_degree": 8,
        "enable_inference_mode": false,
        "fsdp_master_dtype": "float32",
        "fsdp_reduce_dtype": null
      },
      "precision": "bfloat16",
      "predict_text_tokens": false,
      "quantization": {
        "exclude_regex": [],
        "fp8_granularity": "per_row",
        "include_regex": [],
        "method": null,
        "modelopt_fp8_checkpoint_path": null,
        "modelopt_fp8_target_fqns": []
      },
      "rectified_flow_inference_config": {
        "num_train_timesteps": 1000,
        "scheduler_type": "unipc",
        "shift": 1,
        "use_dynamic_shifting": false
      },
      "rectified_flow_training_config": {
        "action_loss_weight": 10.0,
        "image_loss_scale": null,
        "independent_action_schedule": false,
        "independent_sound_schedule": false,
        "loss_scale": 10.0,
        "normalize_loss_by_active": false,
        "sample_level_loss_averaging": false,
        "shift": {
          "256": 3,
          "480": 5,
          "720": 10
        },
        "shift_action": null,
        "shift_image": null,
        "shift_sound": null,
        "sound_loss_scale": 2.0,
        "train_time_action_distribution": "logitnormal",
        "train_time_image_distribution": "logitnormal",
        "train_time_sound_distribution": "logitnormal",
        "train_time_video_distribution": "waver",
        "train_time_weight": "uniform",
        "use_discrete_rf": false,
        "use_dynamic_shift": false
